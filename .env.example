# ==============================================================================
# AI-Powered Personalized Learning Platform - Environment Configuration Blueprint
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="AI Personalized Learning Platform"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-secure-secret-key-here"

# Server Configuration
HOST="0.0.0.0"
PORT=8000
ALLOWED_CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL Database (v16 with JSONB support)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/learning_platform"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis & Job Queues (ARQ / Celery)
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_URL="redis://localhost:6379/1"
QUEUE_NAME_TEXT="queue:text_jobs"
QUEUE_NAME_VIDEO="queue:video_jobs"

# Authentication Provider (Clerk or Firebase Auth)
AUTH_PROVIDER="clerk" # Options: clerk, firebase
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
CLERK_ISSUER_URL="https://clerk.your-domain.com"
FIREBASE_PROJECT_ID=""
FIREBASE_CREDENTIALS_JSON_PATH=""

# Media & Object Storage (S3-compatible: AWS S3, Cloudflare R2, MinIO)
STORAGE_PROVIDER="minio" # Options: minio, s3, r2
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_NAME="learning-platform-media"
S3_REGION="us-east-1"
CDN_BASE_URL="http://localhost:9000/learning-platform-media"
SIGNED_URL_EXPIRATION_SECONDS=3600

# LLM Providers (Fast and Strong tiers configured via config, not hardcoded)
LLM_PROVIDER="gemini" # Options: gemini, openai, anthropic
LLM_API_KEY=""
LLM_MODEL_FAST="gemini-1.5-flash"   # Prompt analysis, quiz generation, short-answer grading
LLM_MODEL_STRONG="gemini-1.5-pro"   # Course outline, lesson content, video script, AI tutor

# Text-to-Speech (TTS) Provider
TTS_PROVIDER="elevenlabs" # Options: elevenlabs, openai, edge_tts
TTS_API_KEY=""
TTS_DEFAULT_VOICE_ID=""

# Image Generation Provider
IMAGE_GEN_PROVIDER="fal" # Options: fal, replicate, openai
IMAGE_GEN_API_KEY=""

# Observability and Error Tracking
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""

# Frontend Public Configuration (Next.js / Vite)
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

